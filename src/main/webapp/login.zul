<?page title="Login" contentType="text/html;charset=UTF-8"?>

<zk>
    <!-- Contenitore Flexbox per centrare la finestra nella pagina -->
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f4f6f9;">

        <window
            id="loginWindow"
            apply="com.amalfi.nidaco.controller.LoginComposer"
            title="Login"
            border="normal"
            width="350px">

            <vlayout spacing="15px" style="padding: 20px; text-align: center;">

                <!-- Logo centrato sopra i campi -->
                <image src="/images/Logo-NIDACO-costruzioni.png" width="220px" style="margin-bottom: 10px;" />

                <textbox
                    id="username"
                    placeholder="Username"
                    width="100%" />

                <textbox
                    id="password"
                    type="password"
                    placeholder="Password"
                    width="100%" />

                <button
                    id="loginBtn"
                    label="Accedi"
                    width="100%" />

            </vlayout>

        </window>

    </div>
</zk>